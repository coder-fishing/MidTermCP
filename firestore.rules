rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'pIflhY70uhU5LlryT7tLFYn3NYN2';
    }

    match /users/{userId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['email', 'name', 'pass', 'avtUrl'])
        && request.resource.data.keys().hasOnly(['email', 'name', 'pass', 'avtUrl'])
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.pass is string
        && request.resource.data.avtUrl is string;
    }
  }
}
